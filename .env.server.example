# Service environment (e.g. prod, dev)
APP_ENV="prod"

# Service  configuration
PROTOBUF_VERSION="32.1"

# Whether to enable FIPS mode ("true" or "false")
FIPS_MODE_ENABLED="true"

# Version of the FIPS mode module to use
FIPS_MODE_MODULE_VERSION="v1.0.0"

# Value of the GODEBUG environment variable to use when FIPS mode is enabled
# Example: "fips140=on", "fips140=only", "fips140=off"
FIPS_GODEBUG_VALUE="fips140=on"

### OpenTelemetry settings ###
# OTEL_SERVICE_NAME is OpenTelemetry environment variable that specifies the service name for traces
OTEL_SERVICE_NAME="crypto-broker-server"

# Logs
# 'console', 'otlphttp', 'otlpgrpc', 'none' or comma-separated list like 'console,otlphttp', 'console,otlpgrpc'
OTEL_LOGS_EXPORTER="console,otlpgrpc"

# Logs level
# 'debug', 'info', 'warn', 'error'
OTEL_LOGS_LEVEL="debug"

# Logs format
# 'json', 'text'
OTEL_LOGS_FORMAT="json"

# Logs output
# 'stdout', 'stderr'
OTEL_LOGS_OUTPUT="stdout"

# Metrics
# 'console', 'otlphttp', 'otlpgrpc', 'none' or comma-separated combinations.
OTEL_METRICS_EXPORTER="otlpgrpc"

# Metrics collection interval (e.g., '30s', '1m', '5m')
OTEL_METRICS_INTERVAL="10s"

# Traces
# 'otlphttp', 'otlpgrpc', 'console',  'none' or comma-separated list like 'console,otlphttp', 'console,otlpgrpc'
OTEL_TRACES_EXPORTER="otlpgrpc"

# always_on, always_off, traceidratio, parentbased_always_on, parentbased_always_off, parentbased_traceidratio
OTEL_TRACES_SAMPLER="always_on"

# Sampling ratio (0.0-1.0) when using ratio-based samplers like traceidratio or parentbased_traceidratio.
OTEL_TRACES_SAMPLER_ARG="0.1"

# Exporter settings
# Valid URL (only used when OTLP exporter is enabled). Use "https://<your-tenant-id>.live.dynatrace.com/api/v2/otlp" for Dynatrace HTTP OTLP
OTEL_EXPORTER_OTLP_ENDPOINT="localhost:4317"

# Authorization header for OTLP exporter
OTEL_EXPORTER_OTLP_HEADERS_AUTHORIZATION="API-Token"

# PProf address
PPROF_ADDR=127.0.0.1:6060

# Set max number of concurrent streams for grpc server
GRPC_MAX_CONCURRENT_STREAMS=1024